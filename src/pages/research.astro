---
import { getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const about = await getEntry("about", "profile");
if (!about) {
  throw new Error("Missing about/profile.md content entry");
}

const experience = about.data.experience ?? [];
const events = about.data.events ?? [];
const publications = about.data.publications ?? [];
const posters = about.data.posters ?? [];
const highlightedAuthor = about.data.name;

const authorParts = (authors: string) => authors.split(highlightedAuthor);
const contributionParts = (contributions: string) =>
  contributions.split(/\b(verifier|VS Code extension)\b/g);
---

<BaseLayout title="Research | Ricardo Costa">
  <div class="container page">
    <section class="hero compact">
      <p class="eyebrow">LASIGE</p>
      <h1>Research</h1>
      <p>Research work, publications, posters, and events around software verification, developer tools, and AI.</p>
    </section>

    {
      experience.length ? (
        <section class="section" aria-label="Research experience">
          <div class="section-header">
            <h2>Experience</h2>
          </div>
          <div class="education-list">
            {experience.map((item) => (
              <article class="education-card card">
                <div class="education-card-header">
                  <div>
                    <p>{item.period}</p>
                    <h2>{item.role}</h2>
                  </div>
                  <strong>
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noreferrer">
                        {item.organization}
                      </a>
                    ) : (
                      item.organization
                    )}
                  </strong>
                </div>
                <ul class="education-facts">
                  <li>
                    <strong>Project:</strong>{" "}
                    {item.projectHref ? (
                      <>
                        {item.project.split("LiquidJava")[0]}
                        <a href={item.projectHref} target="_blank" rel="noreferrer">LiquidJava</a>
                        {item.project.split("LiquidJava").slice(1).join("LiquidJava")}
                      </>
                    ) : item.project}
                    {item.workstreams?.length ? (
                      <ul class="research-workstreams">
                        {item.workstreams.map((workstream) => (
                          <li><strong>{workstream.label}:</strong> {workstream.detail}</li>
                        ))}
                      </ul>
                    ) : null}
                  </li>
                  <li>
                    <strong>Contributions:</strong>{" "}
                    {contributionParts(item.contributions).map((part) =>
                      part === "verifier" && item.verifierHref ? (
                        <a href={item.verifierHref} target="_blank" rel="noreferrer">{part}</a>
                      ) : part === "VS Code extension" && item.extensionHref ? (
                        <a href={item.extensionHref} target="_blank" rel="noreferrer">{part}</a>
                      ) : part
                    )}
                  </li>
                  {item.funding ? (
                    <li>
                      <strong>Funding:</strong>{" "}
                      {item.fundingHref ? (
                        <a href={item.fundingHref} target="_blank" rel="noreferrer">{item.funding}</a>
                      ) : item.funding}
                    </li>
                  ) : null}
                </ul>
              </article>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      publications.length ? (
        <section class="section" aria-label="Publications">
          <div class="section-header">
            <h2>Publications</h2>
          </div>
          <ul class="output-list">
            {publications.map((publication) => (
              <li>
                <strong>{publication.title}</strong>
                <span>
                  {
                    authorParts(publication.authors).map((part, index, parts) => (
                      <>
                        {part}
                        {index < parts.length - 1 ? <u>{highlightedAuthor}</u> : null}
                      </>
                    ))
                  }
                  {" · "}
                  {publication.statusHref ? (
                    <a href={publication.statusHref} target="_blank" rel="noreferrer">
                      {publication.status}
                    </a>
                  ) : (
                    publication.status
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      posters.length ? (
        <section class="section" aria-label="Posters">
          <div class="section-header">
            <h2>Posters</h2>
          </div>
          <ul class="output-list">
            {posters.map((poster) => (
              <li>
                {poster.href ? (
                  <a href={poster.href} target="_blank" rel="noreferrer">{poster.title}</a>
                ) : (
                  <strong>{poster.title}</strong>
                )}
                <span>
                  {
                    authorParts(poster.authors).map((part, index, parts) => (
                      <>
                        {part}
                        {index < parts.length - 1 ? <u>{highlightedAuthor}</u> : null}
                      </>
                    ))
                  }
                  {poster.note ? ` · ${poster.note}` : ""}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      events.length ? (
        <section class="section" aria-label="Events">
          <div class="section-header">
            <h2>Events</h2>
          </div>
          <ul class="output-list">
            {events.map((item) => (
              <li>
                <strong>{item.role}</strong>
                <span>
                  {item.eventHref ? (
                    <a href={item.eventHref} target="_blank" rel="noreferrer">{item.event}</a>
                  ) : (
                    item.event
                  )}
                  {item.title ? (
                    <>
                      {" · "}
                      {item.href ? (
                        <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a>
                      ) : item.title}
                    </>
                  ) : null}
                  {` · ${item.location}`}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

  </div>
</BaseLayout>

<style lang="scss">
  .compact {
    padding-bottom: 2rem;
  }

  .output-list span {
    color: var(--muted);
  }

  .output-list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .output-list li {
    display: grid;
    gap: 0.25rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .research-workstreams {
    display: grid;
    gap: 0.45rem;
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

</style>
