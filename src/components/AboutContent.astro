---
import { getEntry } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import ContactLinks from "@components/ContactLinks.astro";

const about = await getEntry("about", "profile");
if (!about) {
  throw new Error("Missing about/profile.md content entry");
}

const markdownProcessor = await createMarkdownProcessor();
const summary = await Promise.all(
  about.data.summary.map(async (line) => {
    const { code } = await markdownProcessor.render(line);
    return code.trim().replace(/^<p>/, "").replace(/<\/p>$/, "");
  })
);
---

<div class="container page">
  <section class="hero hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">{about.data.location}</p>
      <h1>{about.data.name}</h1>
      {summary.map((line) => <p set:html={line} />)}
      <ContactLinks contacts={about.data.contacts} />
    </div>

    <figure class="profile-photo">
      <div class="profile-photo-image">
        <img
          src="/profile.jpg"
          alt="Ricardo Costa speaking at a presentation"
          width="550"
          height="688"
          loading="eager"
          decoding="async"
        />
      </div>
    </figure>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Interests</h2>
    </div>
    <ul class="tag-list large-tags">
      {about.data.interests.map((interest) => <li>{interest}</li>)}
    </ul>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Skills</h2>
    </div>
    <div class="skills-grid">
      {
        about.data.skills.map((skillGroup) => (
          <article class="skill-group">
            <h3>{skillGroup.group}</h3>
            <ul class="tag-list">
              {skillGroup.items.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</div>

<style lang="scss">
  .large-tags li {
    padding: 0.4rem 0.7rem;
    font-size: 0.95rem;
  }

  .hero {
    align-items: center;
  }

  .hero-layout {
    display: flex;
    justify-content: space-between;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .hero-copy {
    display: grid;
    gap: 0.9rem;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 760px;
  }

  .hero-copy h1 {
    margin-bottom: 0;
  }

  .profile-photo {
    position: relative;
    z-index: 0;
    flex: 0 0 400px;
    width: 400px;
    margin: 0 0 0 auto;
    padding: 0.55rem;
    border: 1px solid var(--border);
    border-radius: 1.35rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    box-shadow: var(--shadow);
    transform: rotate(2deg);
  }

  .profile-photo::before {
    position: absolute;
    z-index: -1;
    inset: 1.15rem -0.8rem -0.8rem 1.15rem;
    border-radius: 1.35rem;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    content: "";
  }

  .profile-photo img {
    display: block;
    width: 100%;
    height: auto;
    transform: scale(1.3);
    transform-origin: 54% 30%;
  }

  .profile-photo-image {
    overflow: hidden;
    border-radius: 0.95rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  .skill-group {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .skill-group h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .hero-layout {
      flex-direction: column;
      gap: 2.5rem;
    }

    .profile-photo {
      flex-basis: auto;
      width: min(100%, 300px);
      margin-inline: auto;
      transform: rotate(1deg);
    }
  }
</style>
